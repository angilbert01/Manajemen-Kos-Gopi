# Salin menjadi .env lalu isi. File .env tidak di-commit (sudah ada di .gitignore).

# Chatbot Telegram (WBS 5.1-5.2). Buat bot lewat @BotFather di Telegram, tempel tokennya di sini.
# Kosongkan untuk menonaktifkan chatbot.
TELEGRAM_BOT_TOKEN=

# Pembayaran online (WBS 5.3-5.4). Server Key SANDBOX dari dashboard.sandbox.midtrans.com
# (Settings > Access Keys). Kosongkan untuk mode simulasi (halaman bayar tiruan, tanpa uang).
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# Alamat API yang bisa dibuka pembayar untuk link mode simulasi (default http://127.0.0.1:3001).
# PUBLIC_URL=

# API hanya mendengarkan komputer ini karena belum ada login. Ubah ke 0.0.0.0 hanya bila sengaja dibuka.
# HOST=127.0.0.1
