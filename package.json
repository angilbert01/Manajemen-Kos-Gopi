{
  "name": "manajemen-kos-gopi",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "start:api": "node --disable-warning=ExperimentalWarning server/index.ts",
    "db:seed": "node --disable-warning=ExperimentalWarning server/seed.ts",
    "test:api": "node --disable-warning=ExperimentalWarning --test \"server/**/*.test.ts\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.6",
    "typescript": "~5.8.3",
    "vite": "^7.1.7"
  }
}
